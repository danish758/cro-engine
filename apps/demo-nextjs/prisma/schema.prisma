// Prisma schema. Uses SQLite for local dev; swapping to Postgres later only
// requires changing `provider` + `url` below — the models are already
// Postgres-compatible (no SQLite-only types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Mirrors the experiment configs defined in src/lib/experiments.config.ts.
// That static module is the source of truth read by the (edge-runtime)
// middleware — see DESIGN.md for why middleware can't query this table
// directly. This table exists so experiments are queryable like real data
// (e.g. by the dashboard or a future admin API) and is populated by
// `prisma/seed.ts` from the same static config.
model Experiment {
  id            String   @id @default(cuid())
  key           String   @unique
  status        String
  variantsJson  String
  targetingJson String?
  seed          Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One row per (userId, experimentKey) — enforced by the unique index below
// as a defense-in-depth backstop. The application layer already checks for
// an existing row before inserting (see src/lib/exposure.ts); the unique
// constraint guards against a race between two concurrent requests for a
// brand-new user hitting the check-then-insert gap at the same time.
model Exposure {
  id            String   @id @default(cuid())
  userId        String
  experimentKey String
  variantKey    String
  createdAt     DateTime @default(now())

  @@unique([userId, experimentKey])
  @@index([experimentKey])
}

// A user can convert multiple times for the same event; conversion rate is
// computed as unique converting users / unique exposed users, not raw event
// count — see src/lib/stats.ts.
model Conversion {
  id        String   @id @default(cuid())
  userId    String
  eventName String
  value     Float?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([userId])
}

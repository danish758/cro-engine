{
  "name": "cro-engine",
  "private": true,
  "version": "0.1.0",
  "description": "CRO Engine: the engine packages (assignment-engine, stats-engine, sdk) and the platform API that serves experiment config to them.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}

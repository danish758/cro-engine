{
  "name": "cro-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Server-side experimentation platform - assignment engine, stats engine, a client SDK, and a multi-tenant Next.js control plane",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/assignment-engine --workspace=packages/stats-engine --workspace=packages/sdk",
    "test": "npm run test --workspace=packages/assignment-engine --workspace=packages/stats-engine --workspace=packages/sdk",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace=apps/platform"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}

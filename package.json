{
  "name": "cro-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Server-side experimentation engine (CRO platform) - assignment engine, stats engine, and a Next.js reference implementation",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/assignment-engine --workspace=packages/stats-engine",
    "test": "npm run test --workspace=packages/assignment-engine --workspace=packages/stats-engine",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace=apps/demo-nextjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
